# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=

# Local DeepSeek use: uncomment the provider and fill in your DeepSeek key.
# All three roles (agent, simulated user, judge) default to deepseek-flash.
# CS329Z_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# CS329Z_DEEPSEEK_THINKING=disabled  # enabled also supported; may need more max_tokens
# CS329Z_GRADING_MODEL=deepseek-flash
# CS329Z_USER_MODEL=deepseek-flash
# CS329Z_JUDGE_MODEL=deepseek-v4-pro

# Optional overrides
# CS329Z_GRADING_MODEL=openai/gpt-6-luna  # the model LM() calls (an OpenRouter name); grading uses the default
# CS329Z_REASONING_EFFORT=low # reasoning effort for models that accept it
# CS329Z_BUDGET_USD=25        # your own stop: the LM wrapper refuses new calls once the ledger reaches this
# CS329Z_EVAL_SLICE=5         # run live tests on the first N items only
